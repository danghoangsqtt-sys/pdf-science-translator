{
  "name": "pdf-translate",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "description": "PDF Translate - offline desktop PDF translator (Electron + React UI over the local FastAPI backend)",
  "author": "DHsystem",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:viewer": "node --experimental-strip-types --test tests/pdfViewport.test.ts tests/windowBounds.test.ts && npm run build && node tests/run-viewer.cjs",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.vitranslate.pdf",
    "productName": "PDF Translate",
    "asar": true,
    "icon": "public/icon.png",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.png"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../BAN-CHAY/python_runtime",
        "to": "python_runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend/pdf2zh",
        "to": "backend/pdf2zh",
        "filter": [
          "**/*",
          "!__pycache__",
          "!**/__pycache__"
        ]
      },
      {
        "from": "../backend/scripts/translate_pdf.py",
        "to": "backend/scripts/translate_pdf.py"
      },
      {
        "from": "../backend/server",
        "to": "backend/server",
        "filter": [
          "**/*",
          "!data",
          "!__pycache__",
          "!**/__pycache__"
        ]
      },
      {
        "from": "../backend/app/assets/doclayout.onnx",
        "to": "backend/app/assets/doclayout.onnx"
      },
      {
        "from": "../backend/app/assets/GoNotoKurrent-Regular.ttf",
        "to": "backend/app/assets/GoNotoKurrent-Regular.ttf"
      }
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "axios": "^1.16.1",
    "lucide-react": "^1.16.0",
    "pdfjs-dist": "5.4.296",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-pdf": "^10.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.14",
    "tailwindcss": "3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  }
}
