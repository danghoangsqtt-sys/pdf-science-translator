.venv/
__pycache__/
*.py[cod]
.pytest_cache/
output/
tmp/
dist/
build/
backend/app/assets/*.onnx
backend/app/assets/*.ttf
backend/app/assets/*.optimized

# Tool caches. .ruff_cache only stayed out of commits because of a global
# excludes file, which no fresh clone has.
.ruff_cache/

# What the app itself writes next to the PDFs it is given.
translated/
pdf-translate.log

# onnxruntime serialises a 71 MB hardware-specific graph beside any model it
# loads, and it is only valid on the machine that built it.
*.optimized

# Editor and OS droppings.
.vscode/
.idea/
.gradle/
.kotlin/
frontend/android/.gradle/
frontend/android/.kotlin/
frontend/android/.idea/
frontend/android/build/
frontend/android/app/build/
# Machine-specific SDK path; a committed one breaks every other checkout.
frontend/android/local.properties
# Signing material never belongs in the repository.
frontend/android/keystore.properties
*.jks
*.keystore
.DS_Store
Thumbs.db
desktop.ini

# Personal agent overrides stay local. Shared Codex/Claude instructions are
# tracked in AGENTS.md, CLAUDE.md, .claude/skills/, and agent-knowledge/.
/CLAUDE.local.md
/.claude/settings.local.json

# Offline development and native/model outputs.
.venv312/
node_modules/
frontend/dist/
frontend/dist-electron/
frontend/release/
frontend/*.tsbuildinfo
backend/server/data/
models/
.cache/
*.gguf

# Everything that is not source stays inside the project folder but out of
# git: samples, output and scratch in _workspace/, installable builds in
# BAN-CAI-DAT/, the runtime used on this machine in BAN-CHAY/ (see docs/README.md).
/_workspace/
/BAN-CAI-DAT/
/BAN-CHAY/
test_samples/
test_output/
design-review/
/NVIDIA Corporation/
/.claude/launch.json
