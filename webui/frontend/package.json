{
  "name": "pdf-translate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "description": "PDF Translate - Minimal Electron + React Desktop App",
  "author": "Code4Life",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.vitranslate.pdf",
    "productName": "PDF Translate",
    "asar": true,
    "icon": "../icon.png",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../icon.png"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../python_runtime",
        "to": "python_runtime",
        "filter": ["**/*"]
      },
      {
        "from": "../../pdf2zh",
        "to": "pdf2zh",
        "filter": ["**/*", "!__pycache__", "!**/__pycache__"]
      },
      {
        "from": "../../scripts/translate_pdf.py",
        "to": "scripts/translate_pdf.py"
      },
      {
        "from": "../backend",
        "to": "webui/backend",
        "filter": ["**/*", "!data", "!__pycache__", "!**/__pycache__"]
      },
      {
        "from": "../../app/assets/doclayout.onnx",
        "to": "app/assets/doclayout.onnx"
      },
      {
        "from": "../../app/assets/GoNotoKurrent-Regular.ttf",
        "to": "app/assets/GoNotoKurrent-Regular.ttf"
      }
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "autoprefixer": "^10.5.0",
    "axios": "^1.16.1",
    "lucide-react": "^1.16.0",
    "pdfjs-dist": "5.4.296",
    "postcss": "^8.5.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-pdf": "^10.4.1",
    "tailwindcss": "3.4.17"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  }
}
